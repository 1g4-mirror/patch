. $srcdir/test-lib.sh

require cat
require timeout
use_local_patch
use_tmpdir

# ==============================================================

# A normal-format diff command such as "3d2" followed by a line with
# just "." was misdetected as an ed script.  do_ed_script rejected the
# command and consumed nothing, so patch looped forever.

cat > f <<EOF
a
b
c
EOF

cat > bad.diff <<EOF
3d2
.
EOF

check 'timeout 10 $PATCH -i bad.diff f || echo "Status: $?"' <<EOF
$PATCH: **** Only garbage was found in the patch input.
Status: 2
EOF
